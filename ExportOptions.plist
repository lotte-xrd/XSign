<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development: instala nos aparelhos do perfil. Troque por ad-hoc se o
	     seu perfil for ad-hoc. Para conta paga de distribuição, use app-store. -->
	<key>method</key>
	<string>development</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>compileBitcode</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
	<!-- Preencha com o ID da sua equipe, ou deixe o workflow passar via DEVELOPMENT_TEAM. -->
	<key>teamID</key>
	<string>REPLACE_WITH_TEAM_ID</string>
</dict>
</plist>
